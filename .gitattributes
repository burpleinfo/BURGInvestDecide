# Normalize line endings across platforms.
# Goal: keep text files LF in the repo and in working trees, avoid CRLF churn on Windows.

# Auto-detect text files.
* text=auto

# Force LF for common source/text formats.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.txt  text eol=lf
*.env  text eol=lf

# Shell scripts should always be LF.
*.sh   text eol=lf

# Windows scripts can stay CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
